{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["sin1"],
  "functions": {
    "api/tick.js": {
      "maxDuration": 60
    },
    "api/dashboard.js": {
      "maxDuration": 60,
      "includeFiles": [
        "config/**",
        "data/spread.json",
        "data/meta.json",
        "results/**"
      ]
    },
    "api/kill.js": {
      "maxDuration": 30
    },
    "api/health.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/index.html", "destination": "/public/index.html" },
    { "source": "/style.css", "destination": "/public/style.css" },
    { "source": "/app.js", "destination": "/public/app.js" },
    { "source": "/data.js", "destination": "/public/data.js" },
    { "source": "/data/:path*", "destination": "/public/data/:path*" }
  ],
  "crons": [
    {
      "path": "/api/tick",
      "schedule": "7 1 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
