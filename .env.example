# Salin menjadi .env untuk pemakaian lokal. JANGAN commit .env.
# Di Vercel, isi nilai yang sama lewat Project Settings -> Environment Variables.

# Secret untuk memanggil /api/tick. Buat acak, misal: openssl rand -hex 32
CRON_SECRET=ganti_dengan_string_acak_panjang

# Upstash Redis (REST). Ambil dari console.upstash.com -> Redis -> REST API.
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Set "file" untuk mode lokal tanpa Upstash (menulis ke folder ./logs).
# Di Vercel wajib "upstash" (default).
STORE=upstash

# Kill switch manual: "1" = stop membuka posisi baru. Bisa juga lewat Redis key "killswitch".
KILL_SWITCH=0

# Opsional: token untuk endpoint dashboard publik (kosongkan = publik read-only).
DASHBOARD_TOKEN=
